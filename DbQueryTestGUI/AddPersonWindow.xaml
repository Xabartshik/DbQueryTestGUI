<Window x:Class="DbQueryTestGUI.AddPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление пациента" Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#2B2D31" Foreground="#DBDEE1" FontFamily="Segoe UI" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Фамилия:" Foreground="#949BA4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtFam" Margin="0,0,0,10"/>

            <TextBlock Text="Имя:" Foreground="#949BA4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtIm" Margin="0,0,0,10"/>

            <TextBlock Text="Отчество:" Foreground="#949BA4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtOt" Margin="0,0,0,10"/>

            <TextBlock Text="Дата рождения (ДД.ММ.ГГГГ):" Foreground="#949BA4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDr" Margin="0,0,0,10"/>

            <TextBlock Text="ЕНП (16 цифр полиса):" Foreground="#949BA4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtEnp" Margin="0,0,0,10"/>

            <TextBlock Text="Код МО (LPU):" Foreground="#949BA4" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLpu"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="80" Height="30" Click="BtnCancel_Click" Background="#4E5058" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Width="90" Height="30" Click="BtnSave_Click" Background="#5865F2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>